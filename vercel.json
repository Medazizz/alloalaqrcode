{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/qrcode/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/qrcode",
      "destination": "/index.html"
    },
    {
      "source": "/qrcode/",
      "destination": "/index.html"
    },
    {
      "source": "/qrcode/:path*",
      "destination": "/:path*"
    }
  ]
}
